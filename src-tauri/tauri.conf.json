{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "malt",
  "version": "0.4.21",
  "identifier": "com.carychao.malt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "malt",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--touch-events=disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/MichaelCarychao/malt/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDMEE2MDU2MTZCRTJBM0MKUldROEtyNFdWbUFLUE01VlJidG9vWFVYYzhVSzBwNlBQR1YrSWx0eWEwWHZURWdmSWNadGRQeWkK"
    }
  }
}
